{
  "name": "@option-decode/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "db:sync-lot-sizes": "tsc -p tsconfig.json && node dist/db/src/sync-lot-sizes.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "DATABASE_URL=\"${DATABASE_URL:-mysql://test:test@127.0.0.1:3306/test}\" tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@option-decode/analytics": "workspace:*",
    "@option-decode/dhan": "workspace:*",
    "@option-decode/types": "workspace:*",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "^6.0.1",
    "mariadb": "3.4.5",
    "@option-decode/trading": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
