[Unit]
Description=Option Decode Web (Next.js)
After=network.target option-decode-api.service
Wants=option-decode-api.service

[Service]
Type=simple
User=option-decode
Group=option-decode
# CUTOVER: production ports. Kept the app's home at /opt/option-decode-native
# rather than renaming to /opt/option-decode.
WorkingDirectory=/opt/option-decode-native/current
EnvironmentFile=/opt/option-decode-native/current/.env.production
Environment=NODE_ENV=production
Environment=API_URL=http://127.0.0.1:4000

# apps/web/package.json's "start" script hardcodes `next start -p 3000`,
# which is what we actually want now, but invoking next directly (rather
# than through the npm script) keeps this consistent/explicit either way.
ExecStart=/usr/bin/pnpm --filter @option-decode/web exec next start -p 3000

StandardOutput=append:/opt/option-decode-native/logs/web/web.log
StandardError=append:/opt/option-decode-native/logs/web/web.log

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/option-decode-native/logs /opt/option-decode-native/current

[Install]
WantedBy=multi-user.target
