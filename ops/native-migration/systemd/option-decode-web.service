[Unit]
Description=Option Decode Web (Next.js)
After=network.target option-decode-api.service
Wants=option-decode-api.service

[Service]
Type=simple
User=option-decode
Group=option-decode
# NOTE: points at /opt/option-decode-native, the isolated pre-cutover
# testing base - deliberately NOT /opt/option-decode (the live Docker
# checkout). At cutover (step 9), install a copy of this unit with every
# /opt/option-decode-native path below changed to /opt/option-decode.
WorkingDirectory=/opt/option-decode-native/current
EnvironmentFile=/opt/option-decode-native/current/.env.production
Environment=NODE_ENV=production
Environment=API_URL=http://127.0.0.1:4001
Environment=PORT=3001

ExecStart=/usr/bin/pnpm --filter @option-decode/web start

StandardOutput=append:/opt/option-decode-native/logs/web/web.log
StandardError=append:/opt/option-decode-native/logs/web/web.log

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/option-decode-native/logs /opt/option-decode-native/current

[Install]
WantedBy=multi-user.target
