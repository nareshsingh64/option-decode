[Unit]
Description=Option Decode Worker (BullMQ)
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=option-decode
Group=option-decode
# CUTOVER: production ports/paths. This unit now becomes THE live worker -
# the Docker worker will be stopped as part of this same cutover, so the
# "don't run both at once" caution from the testing phase no longer
# applies once Docker is down. Kept the app's home at
# /opt/option-decode-native rather than renaming to /opt/option-decode.
WorkingDirectory=/opt/option-decode-native/current
EnvironmentFile=/opt/option-decode-native/current/.env.production
Environment=NODE_ENV=production
Environment=API_PORT=4000
Environment=REDIS_URL=redis://127.0.0.1:6379/0
# glibc's allocator was confirmed (2026-08-05, via a live malloc_trim(0) that
# recovered 4.6 of 4.9GB RSS in under a second, no leak) to be fragmenting
# under this process's allocation churn rather than returning freed memory
# to the OS - RSS climbed to 6-7GB within a single 15-minute cycle on this
# host. jemalloc returns memory far more eagerly by default, so this avoids
# the problem instead of needing a periodic manual trim. Package is
# `libjemalloc2` (already present on this host); path is arch-specific
# (aarch64 here) - confirm with `dpkg -L libjemalloc2 | grep so` before
# reusing this unit on a different architecture.
Environment=LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libjemalloc.so.2

ExecStart=/usr/bin/pnpm --filter @option-decode/worker exec tsx src/worker.ts

StandardOutput=append:/opt/option-decode-native/logs/worker/worker.log
StandardError=append:/opt/option-decode-native/logs/worker/worker.log

Restart=on-failure
RestartSec=5

# Explicit rather than relying on systemd's 90s default: the worker's
# SIGTERM handler (apps/worker/src/worker.ts's shutdown()) calls
# worker.close() on every BullMQ Worker, which waits for the currently
# running job to finish before resolving. Jobs here are ~30s-cadence
# option-chain/wave-quote captures, not long-running, so 30s is generous
# headroom for graceful shutdown while still leaving the option-decode-
# worker-restart.timer's 15-minute cadence (see that timer's own comment)
# a wide margin before the next scheduled restart fires.
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/option-decode-native/logs /opt/option-decode-native/current

[Install]
WantedBy=multi-user.target
