[Unit]
Description=Option Decode Worker (BullMQ)
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=option-decode
Group=option-decode
# CUTOVER: production ports/paths. This unit now becomes THE live worker -
# the Docker worker will be stopped as part of this same cutover, so the
# "don't run both at once" caution from the testing phase no longer
# applies once Docker is down. Kept the app's home at
# /opt/option-decode-native rather than renaming to /opt/option-decode.
WorkingDirectory=/opt/option-decode-native/current
EnvironmentFile=/opt/option-decode-native/current/.env.production
Environment=NODE_ENV=production
Environment=API_PORT=4000
Environment=REDIS_URL=redis://127.0.0.1:6379/0
# glibc's allocator was confirmed (2026-08-05, via a live malloc_trim(0) that
# recovered 4.6 of 4.9GB RSS in under a second, no leak) to be fragmenting
# under this process's allocation churn rather than returning freed memory
# to the OS - RSS climbed to 6-7GB within a single 15-minute cycle on this
# host. jemalloc returns memory far more eagerly by default, so this avoids
# the problem instead of needing a periodic manual trim. Package is
# `libjemalloc2` (already present on this host); path is arch-specific
# (aarch64 here) - confirm with `dpkg -L libjemalloc2 | grep so` before
# reusing this unit on a different architecture.
Environment=LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libjemalloc.so.2
# jemalloc's DEFAULTS were leaving the win on the table, which is why the
# 2026-08-05 note claiming "570-600MB steady" never reproduced.
#
# Out of the box jemalloc has background_thread DISABLED and a 10s dirty
# decay, so freed pages are returned to the OS only when later allocation
# activity happens to touch that arena. The wave screener's scan is exactly
# the wrong shape for that, driving RSS from 276MB to 2,134MB in one pass
# (measured 2026-08-12) with nothing reclaiming until well afterwards.
#
# The allocating work is the ELLIOTT WAVE ANALYTICS, not the database.
# Isolated on this host over the same 214 symbols:
#   queries only (getWavePriceHistory x214):  peak 225MB, settles to 163MB
#   queries + calculateElliottWave/RSI/RVOL:  peak 976MB, stays  955MB
# getSpotPriceHistory for the 7 indices is cheap too (186MB). So Prisma, the
# mariadb driver and the query volume are all cleared - it is short-lived JS
# churn in the wave engine that V8 collects (heapTotal never leaves ~62MB)
# while the freed pages stay with the allocator.
#
# background_thread:true gives jemalloc a thread that purges rather than
# waiting for opportunistic reclamation. The decays are ZERO, not 2000:
# an earlier attempt paired a 2s decay with a 100ms yield, which cannot work
# - a page must sit dirty for the whole decay window before it is purgeable,
# so a 100ms pause could never trigger a 2s decay. Those two numbers were
# written in the same commit and never checked against each other.
#
# Zero was chosen from a measured A/B, not from theory. Replaying the
# screener scan's per-symbol work in isolation on this host (214 symbols):
#
#   jemalloc defaults (10s decay):  peak 938MB, 288MB after 30s idle
#   dirty_decay_ms:0 + bg thread:   peak 721MB, 136MB after 30s idle
#
# Peak -23%, idle -53%. Both configs DO eventually return the memory, which
# is itself worth knowing: earlier readings of "never returned" were taken
# 5s after the loop, i.e. inside the default 10s decay window.
#
# It costs CPU - purging on free rather than in batches. Watch for the
# screener scan getting slower, and raise it if so.
#
# VALIDATE BEFORE DEPLOYING. A malformed pair makes jemalloc refuse the
# whole string ("<jemalloc>: Invalid conf pair: ...") and the worker starts
# with default behaviour or fails outright, both silently as far as systemd
# is concerned. Check on the host with:
#   LD_PRELOAD=<path> MALLOC_CONF=<value> node -e 'console.log("ok")'
Environment=MALLOC_CONF=background_thread:true,dirty_decay_ms:0,muzzy_decay_ms:0

ExecStart=/usr/bin/pnpm --filter @option-decode/worker exec tsx src/worker.ts

StandardOutput=append:/opt/option-decode-native/logs/worker/worker.log
StandardError=append:/opt/option-decode-native/logs/worker/worker.log

Restart=on-failure
RestartSec=5

# Explicit rather than relying on systemd's 90s default: the worker's
# SIGTERM handler (apps/worker/src/worker.ts's shutdown()) calls
# worker.close() on every BullMQ Worker, which waits for the currently
# running job to finish before resolving. Jobs here are ~30s-cadence
# option-chain/wave-quote captures, not long-running, so 30s is generous
# headroom for graceful shutdown while still leaving the option-decode-
# worker-restart.timer's 15-minute cadence (see that timer's own comment)
# a wide margin before the next scheduled restart fires.
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/option-decode-native/logs /opt/option-decode-native/current

[Install]
WantedBy=multi-user.target
